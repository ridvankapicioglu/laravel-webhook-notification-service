<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Tests use MySQL like the app, but their own "notifications_test" database (created by
             docker/mysql/init). <server> + force="true": inside docker the app's variables are already
             set and Laravel reads $_SERVER first, so these must override them.
             tests/TestCase.php also refuses to run against any database whose name does not end in _test. -->

        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="notifications_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="NOTIFICATION_RATE_LIMIT" value="100" force="true"/>
        <server name="NOTIFICATION_MAX_ATTEMPTS" value="5" force="true"/>
    </php>
</phpunit>
