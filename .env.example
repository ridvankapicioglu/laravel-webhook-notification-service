# Only needed when running outside docker, or to override docker-compose defaults.

APP_NAME=notification-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notifications
DB_USERNAME=app
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# External provider, simulated with webhook.site. This URL answers with
# 202 {"messageId":"...","status":"accepted","timestamp":"..."}. To use your own, create a URL on
# https://webhook.site and set that default response in "Edit".
# For load / failure tests use the local mock instead: http://mock-provider:8080
NOTIFICATION_PROVIDER_URL=https://webhook.site/924656b7-59d1-49ef-bde5-124930bd4665
NOTIFICATION_PROVIDER_TIMEOUT=5
NOTIFICATION_RATE_LIMIT=100
NOTIFICATION_MAX_ATTEMPTS=5

# Mock provider (docker only): share of requests that fail with 500/503/429, to see retries.
MOCK_FAILURE_RATE=0
